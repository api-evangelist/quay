{
  "opencollection": "1.0.0",
  "info": {
    "name": "Quay Container Registry Build User API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://quay.io/oauth/authorize",
      "accessTokenUrl": "https://quay.io/oauth/access_token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get authenticated user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://quay.io/api/v1/user/"
          },
          "docs": "Get authenticated user"
        }
      ]
    }
  ],
  "bundled": true
}